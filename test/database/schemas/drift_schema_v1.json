  "fixed_sql": [
    {
      "name": "samples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"samples\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL COLLATE NOCASE UNIQUE CHECK(length(trim(code)) > 0), \"batch_id\" TEXT NULL, \"captured_at\" INTEGER NOT NULL, \"notes\" TEXT NULL, \"detection_status\" TEXT NOT NULL DEFAULT 'not_validated' CHECK(\"detection_status\" IN ('not_validated', 'validated', 'rejected')), \"calibration_status\" TEXT NOT NULL DEFAULT 'not_calibrated' CHECK(\"calibration_status\" IN ('not_calibrated', 'calibrated', 'invalid')), \"sync_status\" TEXT NOT NULL DEFAULT 'pending' CHECK(\"sync_status\" IN ('pending', 'uploading', 'synced', 'failed', 'conflict')), \"revision\" INTEGER NOT NULL DEFAULT 1 CHECK(\"revision\" > 0), \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "model_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"model_metadata\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('detection', 'finishing')), \"version\" TEXT NOT NULL, \"local_path\" TEXT NULL, \"sha256\" TEXT NULL, \"installed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"installed\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"kind\", \"version\"));"
        }
      ]
    },
    {
      "name": "sample_images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sample_images\" (\"id\" TEXT NOT NULL, \"sample_id\" TEXT NOT NULL REFERENCES samples (id) ON DELETE CASCADE, \"view\" TEXT NOT NULL CHECK(\"view\" IN ('end', 'side')), \"local_path\" TEXT NOT NULL UNIQUE, \"byte_count\" INTEGER NOT NULL CHECK(\"byte_count\" > 0), \"detector_model_id\" TEXT NULL REFERENCES model_metadata (id), \"validated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"sample_id\", \"view\"));"
        }
      ]
    },
    {
      "name": "calibrations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"calibrations\" (\"id\" TEXT NOT NULL, \"marker_size_mm\" REAL NOT NULL CHECK(\"marker_size_mm\" > 0.0), \"pixels_per_mm\" REAL NOT NULL CHECK(\"pixels_per_mm\" > 0.0), \"method\" TEXT NOT NULL, \"calibrated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "measurements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"measurements\" (\"id\" TEXT NOT NULL, \"sample_id\" TEXT NOT NULL UNIQUE REFERENCES samples (id) ON DELETE CASCADE, \"maximum_width_mm\" REAL NULL CHECK(\"maximum_width_mm\" > 0.0), \"minimum_width_mm\" REAL NULL CHECK(\"minimum_width_mm\" > 0.0), \"equivalent_diameter_mm\" REAL NULL CHECK(\"equivalent_diameter_mm\" > 0.0), \"outer_circumference_mm\" REAL NULL CHECK(\"outer_circumference_mm\" > 0.0), \"calibration_id\" TEXT NOT NULL REFERENCES calibrations (id), \"algorithm_version\" TEXT NOT NULL, \"calculated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK(maximum_width_mm IS NULL OR minimum_width_mm IS NULL OR maximum_width_mm >= minimum_width_mm));"
        }
      ]
    },
    {
      "name": "finishing_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"finishing_results\" (\"id\" TEXT NOT NULL, \"sample_id\" TEXT NOT NULL UNIQUE REFERENCES samples (id) ON DELETE CASCADE, \"quality\" TEXT NULL, \"confidence\" REAL NULL CHECK(\"confidence\" BETWEEN 0.0 AND 1.0), \"model_id\" TEXT NOT NULL REFERENCES model_metadata (id), \"analyzed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_jobs\" (\"id\" TEXT NOT NULL, \"sample_id\" TEXT NOT NULL UNIQUE REFERENCES samples (id) ON DELETE CASCADE, \"status\" TEXT NOT NULL DEFAULT 'pending' CHECK(\"status\" IN ('pending', 'uploading', 'synced', 'failed', 'conflict')), \"revision\" INTEGER NOT NULL CHECK(\"revision\" > 0), \"idempotency_key\" TEXT NOT NULL UNIQUE, \"attempts\" INTEGER NOT NULL DEFAULT 0 CHECK(\"attempts\" >= 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_preferences\" (\"id\" TEXT NOT NULL, \"key\" TEXT NOT NULL UNIQUE, \"value\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "study_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"study_notes\" (\"id\" TEXT NOT NULL, \"grade_id\" TEXT NOT NULL UNIQUE, \"note\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
